DATABASE_URL="postgresql://user:password@host:5432/horizon_vip_move"
AUTH_SECRET="secret-key"
NEXTAUTH_URL="https://www.vip-move.online"
ADMIN_EMAIL="admin@vip-move.online"
ADMIN_PASSWORD="change-me"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Production Performance & Scalability Settings

# Database Connection Pooling (required for 100+ users)
# Use Vercel Postgres, PgBouncer, or similar service
DATABASE_POOL_SIZE="10"
DATABASE_POOL_TIMEOUT="10"
DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT="30000"

# Redis Cache (highly recommended for 100+ users)
# Uncomment and set for production use
# REDIS_URL="redis://localhost:6379"
# CACHE_TYPE="redis"

# Job Queue for Async Operations (emails, notifications)
# Prevents slow email operations from blocking API responses
JOB_QUEUE_ENABLED="true"
JOB_QUEUE_TYPE="memory" # Change to "bull" for production with Redis

# Rate Limiting (protection against abuse)
RATE_LIMIT_ENABLED="true"
# Login attempts: 5 per 15 minutes
# Registration: 3 per hour  
# Booking creation: 5 per minute per user
# General API: 30 requests per minute

# Analytics & Monitoring
NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_SENTRY_DSN="" # For error tracking

# PWA Settings
NEXT_PUBLIC_PWA_ENABLED="true"

# Node Environment
NODE_ENV="production"

# Vercel Configuration (when deploying)
# VERCEL_ENV="production"
