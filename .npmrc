# NPM Configuration for Horizon VIP Move

# Allow all postinstall scripts needed for dependencies
allow-scripts=true

# Ensure consistent package versions
legacy-peer-deps=false

# Suppress deprecated warnings for indirect dependencies
# These are safe to ignore as they're in transitive dependencies
legacy-peer-deps-warning=false

# Configure npm audit
audit-level=moderate

# Use exact versions in lock file
save-exact=false

# Set up registry
registry=https://registry.npmjs.org/

# Cache configuration
cache-min=10
cache-max=120
